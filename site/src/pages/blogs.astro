---
import Layout from "../layouts/Layout.astro";
import Blogs from "../components/Blogs";
import fs from "node:fs";
import path from "node:path";

const dataPath = path.resolve("public/data/blogs.json");
let manifest: any = { entries: [] };
if (fs.existsSync(dataPath)) {
  manifest = JSON.parse(fs.readFileSync(dataPath, "utf-8"));
}

const entries = manifest.entries ?? [];
const today = new Date();
const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateLine = `${DAYS[today.getUTCDay()]} ${today.getUTCDate()} ${MONTHS[today.getUTCMonth()]} ${today.getUTCFullYear()}`;

const totalMinutes = Math.round(
  entries.reduce((a: number, s: any) => a + (s.audio_duration_s ?? s.long_word_count / 3 ?? 60), 0) / 60
);

const uniqueSources = new Set(entries.map((e: any) => e.source)).size;

const cdnBase = import.meta.env.PUBLIC_CDN_BASE ?? "/data";
---
<Layout title="Briefing / Blogs">
  <div class="wrap">
    <header class="masthead">
      <div class="masthead-top">
        <div class="lhs">
          <span>Vol. 01</span>
          <span>{dateLine}</span>
        </div>
        <div class="rhs">
          <span>{entries.length} entries</span>
          <span>{totalMinutes} min read-aloud</span>
          <span>{uniqueSources} blogs</span>
        </div>
      </div>
      <h1>Briefing<span class="accent">.</span></h1>
      <div class="sub">
        <span class="tagline">
          Long-form engineering + AI blogs, summarised. Each entry stays on the shelf for one month.
        </span>
        <nav class="section-nav">
          <a href="/">News</a>
          <span class="section-nav-sep" aria-hidden="true">·</span>
          <a href="/blogs" class="active">Blogs</a>
        </nav>
      </div>
    </header>
    <Blogs client:load entries={entries} cdnBase={cdnBase} />
  </div>
</Layout>
