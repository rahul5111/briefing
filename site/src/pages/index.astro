---
import Layout from "../layouts/Layout.astro";
import Feed from "../components/Feed";
import fs from "node:fs";
import path from "node:path";

const dataPath = path.resolve("public/data/feed.json");
let manifest: any = { stories: [] };
if (fs.existsSync(dataPath)) {
  manifest = JSON.parse(fs.readFileSync(dataPath, "utf-8"));
}

const stories = manifest.stories ?? [];
const today = new Date();
const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateLine = `${DAYS[today.getUTCDay()]} ${today.getUTCDate()} ${MONTHS[today.getUTCMonth()]} ${today.getUTCFullYear()}`;

const totalMinutes = Math.round(
  stories.reduce((a: number, s: any) => a + (s.estimated_duration_s ?? 60), 0) / 60
);

const uniqueSources = new Set(stories.map((s: any) => s.source_domain || s.source)).size;

const cdnBase = import.meta.env.PUBLIC_CDN_BASE ?? "/data";
---
<Layout title="Briefing">
  <div class="wrap">
    <header class="masthead">
      <div class="masthead-top">
        <div class="lhs">
          <span>Vol. 01</span>
          <span>{dateLine}</span>
        </div>
        <div class="rhs">
          <span>{stories.length} stories</span>
          <span>{totalMinutes} min listen</span>
          <span>{uniqueSources} sources</span>
        </div>
      </div>
      <h1>Briefing<span class="accent">.</span></h1>
      <div class="sub">
        <span class="tagline">
          World news, tech, security and research. Curated across sources, refined by hand, read aloud in a minute or two.
        </span>
        <span>updated 3× daily</span>
      </div>
    </header>
    <Feed client:load stories={stories} cdnBase={cdnBase} />
  </div>
</Layout>
