---
import Layout from "../layouts/Layout.astro";
import Feed from "../components/Feed";
import fs from "node:fs";
import path from "node:path";

const dataPath = path.resolve("public/data/feed.json");
let manifest: any = { stories: [] };
if (fs.existsSync(dataPath)) {
  manifest = JSON.parse(fs.readFileSync(dataPath, "utf-8"));
}

const stories = manifest.stories ?? [];
const today = new Date();
const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateLine = `${DAYS[today.getUTCDay()]} ${today.getUTCDate()} ${MONTHS[today.getUTCMonth()]} ${today.getUTCFullYear()}`;

const totalMinutes = Math.round(
  stories.reduce((a: number, s: any) => a + (s.estimated_duration_s ?? 60), 0) / 60
);

const uniqueSources = new Set(stories.map((s: any) => s.source_domain || s.source)).size;

// B-04: hero greeting + today's briefing size. Today = local calendar
// day at build time in UTC; a small client-side script downgrades the
// greeting word to match the viewer's actual hour after mount.
const todayISO = today.toISOString().slice(0, 10);
const todayStories = stories.filter((s: any) => {
  const ts = s.created_at_ts;
  if (!ts) return false;
  const d = new Date(ts * 1000);
  return d.toISOString().slice(0, 10) === todayISO;
});
const todayMinutes = Math.max(
  1,
  Math.round(
    todayStories.reduce((a: number, s: any) => a + (s.estimated_duration_s ?? 60), 0) / 60
  )
);

const cdnBase = import.meta.env.PUBLIC_CDN_BASE ?? "/data";
---
<Layout title="Briefing">
  <div class="wrap">
    <header class="masthead">
      <div class="masthead-top">
        <div class="lhs">
          <span>Vol. 01</span>
          <span>{dateLine}</span>
        </div>
        <div class="rhs">
          <span>{stories.length} stories</span>
          <span>{totalMinutes} min listen</span>
          <span>{uniqueSources} sources</span>
        </div>
      </div>
      <h1>Briefing<span class="accent">.</span></h1>
      {todayStories.length > 0 && (
        <div class="hero-greet" data-today-count={todayStories.length} data-today-min={todayMinutes}>
          <span class="greet-word">Good day</span>.
          {" "}{todayStories.length} development{todayStories.length === 1 ? "" : "s"} to catch you up
          <span class="greet-sep"> · </span>
          {todayMinutes} min.
        </div>
      )}
      <div class="sub">
        <span class="tagline">
          World news, tech, security and research. Curated across sources, refined for spoken audio, read aloud in one to four minutes.
        </span>
        <nav class="section-nav">
          <a href="/" class="active">News</a>
          <span class="section-nav-sep" aria-hidden="true">·</span>
          <a href="/blogs">Blogs</a>
        </nav>
      </div>
    </header>
    <Feed client:load stories={stories} cdnBase={cdnBase} />
    <script is:inline>
      // B-04: swap "Good day" to time-of-day greeting based on viewer's local clock.
      (function () {
        var el = document.querySelector(".hero-greet .greet-word");
        if (!el) return;
        var h = new Date().getHours();
        el.textContent = h < 12 ? "Good morning" : h < 17 ? "Good afternoon" : "Good evening";
      })();
    </script>
  </div>
</Layout>
